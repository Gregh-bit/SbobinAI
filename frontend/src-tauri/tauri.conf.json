{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SbobinAI",
  "version": "0.0.6",
  "identifier": "com.sbobinai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SbobinAI",
        "width": 1200,
        "height": 800,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:8000 ws://localhost:8000 http://127.0.0.1:8000 ws://127.0.0.1:8000 http://localhost:8765 ws://localhost:8765 http://127.0.0.1:8765 ws://127.0.0.1:8765; media-src 'self' http://localhost:8000 http://127.0.0.1:8000 http://localhost:8765 http://127.0.0.1:8765 blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "resources": {
      "../../backend/*.py": "backend/",
      "../../backend/requirements*.txt": "backend/",
      "../../backend/routers/*.py": "backend/routers/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRUMzREIwMkU0MjcyQjgKUldTNGNrSXVzRDNzWGx6cEYxQ3ZHNmJ1NnJ0MmU4KzNESFE4Q1dwTnI3aTg0TnVaR1M4aVFzYkcK",
      "endpoints": [
        "https://github.com/Gregh-bit/SbobinAI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}